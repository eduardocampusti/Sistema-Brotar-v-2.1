# Frontend (public by design; never place privileged keys in VITE_* variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to http://localhost:3000 when Vite and Express run as separate local processes; leave blank for same-origin deployments.
VITE_API_URL=

# Backend only (validated when the corresponding Gemini or WhatsApp route is called)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Optional server runtime and provider settings
PORT=
GEMINI_MODEL=

# Local diagnostic scripts (use a dedicated, least-privileged test account)
SCRIPT_USER_EMAIL=
SCRIPT_USER_PASSWORD=
SCRIPT_INVALID_PASSWORD=

# RLS integration test account and fixtures (never use production records)
RLS_TEST_RECEPCIONISTA_COCAL_EMAIL=
RLS_TEST_RECEPCIONISTA_COCAL_PASSWORD=
RLS_TEST_SEDE_SCHOOL_ID=
RLS_TEST_SEDE_STUDENT_ID=
